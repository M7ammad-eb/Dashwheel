    <string name="dash_theme_futuristic">Futurystyczny</string>
    <string name="dash_theme_futuristic_desc">Twój samochód jako hologram nad ruchomą siatką świateł, z zaznaczonymi odczytami.</string>
    <string name="dash_theme_simple">Prosty</string>
    <string name="dash_theme_simple_desc">Duże, czytelne liczby, Twój samochód oświetlony jak w salonie, kilka dużych przycisków.</string>
    <string name="dash_theme_modern">Nowoczesny</string>
    <string name="dash_theme_modern_desc">Karty z matowego szkła nad miastem w 3D, podświetlona trasa.</string>
    <string name="dash_theme_motorsport">Motorsport</string>
    <string name="dash_theme_motorsport_desc">Wyświetlacz auta wyścigowego: lampki zmiany biegu, czasy sektorów, ramka w kolorze flagi.</string>
    <string name="dash_theme_anime">Anime</string>
    <string name="dash_theme_anime_desc">Kadry komiksu na tle zachodu słońca, Twój samochód jako mówiąca naklejka.</string>
    <string name="dash_theme_racing">Wyścigi</string>
    <string name="dash_theme_racing_desc">Nocna jazda w neonach: pasiaste słońce, zegary i minimapa jak w grze wyścigowej.</string>
    <string name="dash_theme_panorama">Panorama</string>
    <string name="dash_theme_panorama_desc">Zakrzywiony szklany pas świecących segmentów, twój samochód na podświetlonym cokole i dok jak kierownica.</string>
    <string name="dash_theme_liquid">Płynny</string>
    <string name="dash_theme_liquid_desc">Szkło załamujące światło na jasnym tle, Twój samochód obraca się pośrodku.</string>
    <string name="dash_theme_expressive">Ekspresyjny</string>
    <string name="dash_theme_expressive_desc">Wyraziste kształty i kolory granej muzyki; każdy widżet ma własny kształt.</string>
    <string name="dash_theme_kinetic">Kinetyczny</string>
    <string name="dash_theme_kinetic_desc">Najpierw słowa: następny skręt dużymi ruchomymi literami, reszta przewija się poniżej.</string>
    <string name="dash_theme_glyph">Glif</string>
    <string name="dash_theme_glyph_desc">Cyfry z kropek na jasnym panelu, przyciski jak prawdziwe i paski świetlne na krawędziach.</string>
    <string name="dash_theme_windshield">Przednia szyba</string>
    <string name="dash_theme_windshield_desc">Jeden pas u góry ze wszystkim, na co zerkasz, nad rysowaną drogą nocą.</string>
    <string name="dash_theme_terrain">Teren</string>
    <string name="dash_theme_terrain_desc">Twój samochód na krajobrazie z poziomic, usterka zaznaczona na samej części.</string>
    <string name="dash_theme_ambient">Nastrój</string>
    <string name="dash_theme_ambient_desc">Pole światła i mało słów: ciepła poświata wznosi się po stronie następnego skrętu.</string>
    <string name="dash_theme_brutal">Brutalny</string>
    <string name="dash_theme_brutal_desc">Głośne płaskie kolory, grube obrysy i ogromne litery, czytelne w pełnym słońcu.</string>
    <string name="dash_theme_clay">Glina</string>
    <string name="dash_theme_clay_desc">Miękkie pastelowe kształty jak plastelina, duże okrągłe przyciski i pulchna strzałka 3D.</string>
    <string name="dash_theme_chrome">Chrom</string>
    <string name="dash_theme_chrome_desc">Litery z płynnego chromu, holograficzne plakietki i metalowa kropla, która porusza się z muzyką.</string>
    <string name="dash_theme_spatial">Przestrzenny</string>
    <string name="dash_theme_spatial_desc">Szklane okna unoszące się na różnych głębokościach nad nocnym miastem 3D.</string>
    <string name="dash_theme_paper">Papier</string>
