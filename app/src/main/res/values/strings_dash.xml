    <string name="dash_theme_futuristic">Futuristic</string>
    <string name="dash_theme_futuristic_desc">Your car as a hologram over a moving light grid, readings pointed out on it.</string>
    <string name="dash_theme_simple">Simple</string>
    <string name="dash_theme_simple_desc">Big readable figures, your car lit as in a showroom, a few large buttons.</string>
    <string name="dash_theme_modern">Modern</string>
    <string name="dash_theme_modern_desc">Frosted glass cards over a city in 3D, the route glowing.</string>
    <string name="dash_theme_motorsport">Motorsport</string>
    <string name="dash_theme_motorsport_desc">A race car\'s display: shift lights, sector times, a frame that turns the colour of the flag.</string>
    <string name="dash_theme_anime">Anime</string>
    <string name="dash_theme_anime_desc">Comic panels in a sunset sky, your car as a sticker that talks.</string>
    <string name="dash_theme_racing">Racing</string>
    <string name="dash_theme_racing_desc">A night drive in neon: a striped sun, a racing game\'s dials and minimap.</string>
    <string name="dash_theme_panorama">Panorama</string>
    <string name="dash_theme_panorama_desc">A curved glass band of lit segments, your car on a glowing plinth and a steering wheel dock.</string>
    <string name="dash_theme_liquid">Liquid</string>
    <string name="dash_theme_liquid_desc">Glass that bends the light over a bright wallpaper, your car turning in the middle.</string>
    <string name="dash_theme_expressive">Expressive</string>
    <string name="dash_theme_expressive_desc">Bold shapes and the colours of the music playing; each widget has its own shape.</string>
    <string name="dash_theme_kinetic">Kinetic</string>
    <string name="dash_theme_kinetic_desc">Words first: the next turn in big moving type, the rest rolling by below.</string>
    <string name="dash_theme_glyph">Glyph</string>
    <string name="dash_theme_glyph_desc">Dot-matrix figures on a light panel, real-looking keys and light strips along the edges.</string>
    <string name="dash_theme_windshield">Windshield</string>
    <string name="dash_theme_windshield_desc">One band across the top with everything you glance at, over a drawn road at night.</string>
    <string name="dash_theme_terrain">Terrain</string>
    <string name="dash_theme_terrain_desc">Your car on a landscape of contour lines, a problem pinned on the part itself.</string>
    <string name="dash_theme_ambient">Ambient</string>
    <string name="dash_theme_ambient_desc">A field of light with few words: a warm glow rises from the side of the next turn.</string>
    <string name="dash_theme_brutal">Brutal</string>
    <string name="dash_theme_brutal_desc">Loud flat colours, thick outlines and huge type, made to read in full sun.</string>
    <string name="dash_theme_clay">Clay</string>
    <string name="dash_theme_clay_desc">Soft pastel shapes you could squeeze, big round keys and a puffy 3D turn arrow.</string>
    <string name="dash_theme_chrome">Chrome</string>
    <string name="dash_theme_chrome_desc">Liquid chrome lettering, holographic chips and a metal drop that moves with the music.</string>
    <string name="dash_theme_spatial">Spatial</string>
    <string name="dash_theme_spatial_desc">Glass windows floating at different depths over a 3D city at night.</string>
    <string name="dash_theme_paper">Paper</string>
    <string name="dash_theme_paper_desc">Ink on grey like e-paper: a dotted map, plain facts and nothing that moves.</string>
