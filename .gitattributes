# Normalise line endings: LF in the repo, native on checkout.
* text=auto eol=lf
# Windows batch files: cmd.exe mis-reads labels in an LF-only file.
*.bat text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.webp binary
*.glb binary
*.jar binary
*.keystore binary
*.jks binary
*.tflite binary
*.pbf binary
